{
  "expo": {
    "name": "정check",
    "slug": "welfare-finder-ai",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "welfarefinder",
    "plugins": [
      [
        "expo-calendar",
        {
          "calendarPermission": "정check이 신청 시작일과 마감일을 캘린더에 추가할 수 있도록 접근을 허용해 주세요."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "정check에서 프로필 이미지를 선택할 수 있도록 사진 접근을 허용해 주세요."
        }
      ]
    ],
    "android": {
      "package": "com.estai.welfarefinder",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.estai.welfarefinder",
      "supportsTablet": true
    },
    "extra": {
      "eas": {
        "projectId": "1b471747-4bb5-46af-9c1a-214de28d8fcf"
      }
    }
  }
}
